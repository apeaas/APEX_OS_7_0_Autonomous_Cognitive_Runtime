# APEX OS 7.1 — configuración local
# Copiá este archivo como .env. Nunca publiques ni pegues la clave en index.html o assets/js.

# La plataforma funciona sin clave en modo local/determinístico, pero la IA online y los ciclos cognitivos requieren esta variable.
OPENAI_API_KEY=

# Modelos configurables del backend local.
OPENAI_MODEL=gpt-5.1
OPENAI_REALTIME_MODEL=gpt-realtime

# Límites fail-safe de la consola Realtime (milisegundos o cantidades).
APEX_VOICE_SESSION_TTL_MS=900000
APEX_VOICE_CONNECT_TIMEOUT_MS=20000
APEX_VOICE_MAX_RECONNECTS=3
APEX_VOICE_MAX_TOOL_CALLS=40
APEX_VOICE_MAX_RESPONSES=48

# Solo para desarrollo con un endpoint compatible. En uso normal, dejalo comentado.
# OPENAI_BASE_URL=https://api.openai.com/v1

# El origen 127.0.0.1:5500 preserva el localStorage usado por versiones anteriores.
APEX_HOST=127.0.0.1
APEX_PORT=5500
APEX_AI_RATE_LIMIT=60

# Directorio opcional para la memoria persistente del backend.
# APEX_DATA_DIR=C:\APEX_DATA
